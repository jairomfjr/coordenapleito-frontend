# Produção (VPS Hostinger) — build otimizado.
DOCKER_TARGET=production

# Browser: mesma origem + /coordenapleito-api (Nginx ou proxy do Next).
# Vazio = detecção automática. Não use localhost aqui na VPS.
NEXT_PUBLIC_API_URL=

# Next (servidor) → Spring na VPS. Porta da API em production: 8083.
# Docker na rede net_sps: http://coordenapleito-api:8083
# Jar + Next no mesmo host: http://127.0.0.1:8083
BACKEND_URL=http://coordenapleito-api:8083
